# App branding (used by the Makefile banner)
PROJECT_NAME=Vision Chat
VERSION=0.1.0

# Web UI bind address (used by make ui)
HOST=0.0.0.0
PORT=8000

# Model configuration (read by vision_chat from this file)
MODEL_NAME=Qwen3-VL-2B-Instruct
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_API_KEY=sk-no-key-required
MAX_TOKENS=256

# Hugging Face repo downloaded by make serve
MODEL_REPO=Qwen/Qwen3-VL-2B-Instruct-GGUF

# LangSmith tracing (optional; off by default)
# Tracing activates only when LANGSMITH_TRACING=true AND LANGSMITH_API_KEY is set.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=vision-chat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
